# Preserve your existing EmailJS values when configuring SEO.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional override if the production domain changes.
# Default: https://lemith-portfolio.netlify.app/
# Use the production homepage origin only, with HTTPS and no path.
SITE_URL=

# Optional: the content value from Search Console's HTML verification meta tag.
# This is a public ownership-verification token, not your Google password.
GOOGLE_SITE_VERIFICATION=
